{
  "name": "lyra-swarm",
  "displayName": "Lyra Autonomous Cloud Swarm",
  "description": "Always-available AWS Bedrock autonomous engineering swarm & 3-lane adaptive harness for VS Code",
  "version": "1.3.0",
  "publisher": "lyra-ai",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Testing",
    "Collaboration"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:lyraSwarmSidebar",
    "onCommand:lyra.openStudio",
    "onCommand:lyra.openUniversalChat",
    "onCommand:lyra.dispatch",
    "onCommand:lyra.signIn"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lyra-swarm",
          "title": "Lyra Cloud Swarm",
          "icon": "media/lyra-icon.svg"
        }
      ]
    },
    "views": {
      "lyra-swarm": [
        {
          "id": "lyraCloudSessions",
          "name": "Sessions"
        },
        {
          "type": "webview",
          "id": "lyraSwarmSidebar",
          "name": "Task Runner"
        }
      ]
    },
    "commands": [
      {
        "command": "lyra.openUniversalChat",
        "title": "Open Agent Sessions",
        "category": "Lyra"
      },
      {
        "command": "lyra.newCloudSession",
        "title": "New Session",
        "category": "Lyra",
        "icon": "$(plus)"
      },
      {
        "command": "lyra.refreshSessions",
        "title": "Refresh Sessions",
        "category": "Lyra",
        "icon": "$(refresh)"
      },
      {
        "command": "lyra.openStudio",
        "title": "Open Studio Dashboard",
        "category": "Lyra"
      },
      {
        "command": "lyra.dispatch",
        "title": "Dispatch Task",
        "category": "Lyra"
      },
      {
        "command": "lyra.signIn",
        "title": "Lyra: Sign In to Account",
        "category": "Lyra"
      },
      {
        "command": "lyra.signOut",
        "title": "Lyra: Sign Out",
        "category": "Lyra"
      },
      {
        "command": "lyra.syncGit",
        "title": "Lyra: Sync Working Snapshot to Git",
        "category": "Lyra"
      },
      {
        "command": "lyra.pullResults",
        "title": "Lyra: Pull Verified Swarm Changes",
        "category": "Lyra"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lyra.newCloudSession",
          "when": "view == lyraCloudSessions",
          "group": "navigation@1"
        },
        {
          "command": "lyra.refreshSessions",
          "when": "view == lyraCloudSessions",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Lyra Swarm",
      "properties": {
        "lyra.hubUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "URL to the Lyra Cloud Gateway (http://localhost:3001 for local/LAN, or your deployed AWS Fargate/ECS endpoint). No local background daemon required."
        },
        "lyra.autoPushGit": {
          "type": "boolean",
          "default": true,
          "description": "Automatically commit and push working snapshots before dispatching to the cloud swarm."
        },
        "lyra.defaultPolicyProfile": {
          "type": "string",
          "enum": ["frugal", "balanced", "frontier"],
          "default": "balanced",
          "description": "Default AWS Bedrock Pareto routing policy profile."
        },
        "lyra.autoApplyFastPatch": {
          "type": "boolean",
          "default": false,
          "description": "Automatically apply syntax-verified Lane 1 Fast Patches without requiring 1-click confirmation."
        }
      }
    }
  },
  "scripts": {
    "build": "bun build ./src/extension.ts --outfile=./dist/extension.js --target=node --external=vscode",
    "watch": "bun build ./src/extension.ts --outfile=./dist/extension.js --target=node --external=vscode --watch"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}

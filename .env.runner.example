# Lyra Homelab / Tailscale Runner Configuration
# Copy to .env.runner on each Tailscale server and run scripts/install-runner-service.sh

# WebSocket URL of your Lyra Hub over Tailscale (e.g. ws://100.x.y.z:3001)
LYRA_HUB_URL=ws://100.64.0.1:3001

# Optional bearer token if your Lyra Hub enforces LYRA_RUNNER_TOKEN
# LYRA_RUNNER_TOKEN=

# Unique human-friendly node name & ID for this server
LYRA_RUNNER_NAME=homelab-server-1
# LYRA_RUNNER_ID=node-homelab-1

# Max parallel tasks this server should accept (defaults to CPU count)
LYRA_RUNNER_MAX_CONCURRENCY=4

# Optional sandbox root directory (defaults to ~/.lyra/sandboxes)
# LYRA_RUNNER_DIR=/var/lib/lyra/sandboxes
